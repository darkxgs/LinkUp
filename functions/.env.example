# مفاتiح LiveKit — من https://cloud.livekit.io (Settings → Keys)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=wss://linup-shk03qgl.livekit.cloud

# Google Sign-In — يُملأ تلقائياً عبر scripts/setup-google-auth.mjs
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# اختبار المكالمات والمطابقات: npm run check:calls
# FIREBASE_API_KEY=          # من google-services.json (يُقرأ تلقائياً)
# TEST_USER_EMAIL=
# TEST_USER_PASSWORD=
# TEST_USER_B_EMAIL=         # حساب ثانٍ لاختبار المطابقة (اختياري)
# TEST_USER_B_PASSWORD=

# KYC — Nyckel Gender Detector (مركز التحقق للمضيفات — الأفضل)
# أنشئ حساباً مجانياً: https://www.nyckel.com/pretrained-classifiers/gender-detector/
NYCKEL_CLIENT_ID=
NYCKEL_CLIENT_SECRET=
# اختياري — الافتراضي gender-detector
# NYCKEL_GENDER_FUNCTION_ID=gender-detector

# KYC — بدائل إذا لم يُضبط Nyckel
# الأفضل: Google AI Studio — https://aistudio.google.com/apikey (بدون بطاقة)
GEMINI_API_KEY=
# بديل: Hugging Face — https://huggingface.co/settings/tokens (Read token)
# HF_TOKEN=
# اختياري: AWS Rekognition (5000 صورة/شهر مجاناً لحساب جديد)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-central-1
