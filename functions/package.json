{
  "name": "linkup-functions",
  "description": "Cloud Functions for LinkUp — LiveKit token generation + secure logic",
  "scripts": {
    "build": "npx tsc && node scripts/bundle-room-games.mjs",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "check:calls": "node ../scripts/check-calls-livekit.mjs",
    "check:calls:json": "node ../scripts/check-calls-livekit.mjs --json",
    "check:all": "node ../../scripts/health-check-all.mjs"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1065.0",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.1.0",
    "livekit-server-sdk": "^2.9.0",
    "ws": "^8.18.3"
  },
  "optionalDependencies": {
    "@tensorflow/tfjs-node": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "canvas": "^2.11.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.5.4"
  },
  "private": true
}
