rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ——— صور المستخدمين (تطبيق LinkUp) ———
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024;
    }
    match /albums/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024;
    }
    match /posts/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024;
    }
    match /banners/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024;
    }
    match /rooms/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024;
    }
    match /agencies/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024;
    }
    match /voice_bios/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024;
    }

    // فيديو / موسيقى مشتركة في الروم
    match /room_videos/{roomId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024;
    }
    // حد التطبيق ROOM_MUSIC_MAX_FILE_MB = 120 — القاعدة يجب أن تطابقه
    // (25MB القديمة كانت ترفض الملفات الكبيرة بـ storage/unauthorized)
    match /room_music/{roomId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 120 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }

    // أصول الهدايا من لوحة التحكم
    match /config/gifts/{giftId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 25 * 1024 * 1024;
    }

    // أصول لوحة التحكم — متجر، إطارات، خلفيات، VIP، أرستقراطية
    match /config/store/{itemId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 25 * 1024 * 1024;
    }
    match /config/frames/{frameId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 15 * 1024 * 1024;
    }
    match /config/backgrounds/{bgId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 15 * 1024 * 1024;
    }
    match /config/room-reactions/{packId}/{itemId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 15 * 1024 * 1024;
    }
    match /config/vip/{id}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024;
    }
    // list على المجلدات — لوحة التحكم (استعادة من Storage)
    match /config/aristocracy {
      allow list: if request.auth != null;
    }
    match /config/aristocracy/{id} {
      allow list: if request.auth != null;
    }
    match /config/aristocracy/{id}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024;
    }
    match /config/agency-prince/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024;
    }

    // نسخ APK للتجريب — لوحة التحكم
    match /config/releases/{versionFolder}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 150 * 1024 * 1024;
    }

    // شات + وكالة + بلاغات
    match /locked_media/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024;
    }
    match /chat_images/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /chat_voices/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /chat_videos/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024;
    }
    match /chat_files/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /agency_chat_images/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /agency_chat_voices/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /report_attachments/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // وثائق التحقق من الهوية (KYC) + فيديو
    match /kyc/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 45 * 1024 * 1024;
    }
  }
}
